# ===== LLM Provider(至少配一个)=====
# 阿里云百炼(https://bailian.console.aliyun.com/)— 默认路由(qwen 系)
DASHSCOPE_API_KEY=

# 智谱 GLM(https://open.bigmodel.cn/)— MODEL__* 覆盖为 glm-* 系时使用
GLM_API_KEY=

# ===== 模型分级路由(按 Agent 角色,覆盖代码默认值)=====
# 默认:强=qwen-max 中=qwen-plus 便宜=qwen-turbo embedding=text-embedding-v3
# 切换 GLM 示例:MODEL__WRITER=glm-4.6
# MODEL__SUPERVISOR=qwen-max
# MODEL__OUTLINE=qwen-max
# MODEL__REVIEWER=qwen-max
# MODEL__WRITER=qwen-max
# MODEL__EVENT=qwen-plus
# MODEL__CHARACTER=qwen-turbo
# MODEL__SUMMARY=qwen-turbo
# MODEL__EMBEDDING=text-embedding-v3

# ===== 数据库 =====
NOVEL_DB_PATH=data/novel_agent.db
