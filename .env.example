# ===== LLM Provider(至少配一个)=====
# 阿里云百炼(https://bailian.console.aliyun.com/)— 默认路由,聚合 glm/qwen/deepseek 全系
DASHSCOPE_API_KEY=

# 智谱 GLM 直连(https://open.bigmodel.cn/)— 仅当未配百炼 key 时用于 glm-* 模型
GLM_API_KEY=

# DeepSeek 官方(https://platform.deepseek.com/)— deepseek-* 专属优先于百炼(ADR-0033)
# 注意官方模型名是 deepseek-chat / deepseek-reasoner(非百炼的 deepseek-v3)
# DEEPSEEK_API_KEY=
# MODEL__SUMMARY=deepseek-chat
# 思考控制(ADR-0034/0037):1=官方调用默认关思考(推理 token 挤占写作产出);
# 白名单角色(逗号分隔)恢复思考——评审类需要推理,写作类不需要
# DEEPSEEK_DISABLE_THINKING=1
# DEEPSEEK_THINKING_ROLES=REVIEWER,OUTLINE

# ===== 模型分级路由(按 Agent 角色,覆盖代码默认值)=====
# 默认(全部经百炼):强=glm-5(主控/大纲/审校/写作)
#                   中=deepseek-v3(事实抽取),便宜=deepseek-v3(角色/摘要)
#                   embedding=qwen3.7-text-embedding
# MODEL__SUPERVISOR=glm-5
# MODEL__OUTLINE=glm-5
# MODEL__REVIEWER=glm-5
# MODEL__WRITER=glm-5
# MODEL__EVENT=deepseek-v3
# MODEL__CHARACTER=deepseek-v3
# MODEL__SUMMARY=deepseek-v3
# MODEL__EMBEDDING=qwen3.7-text-embedding

# ===== 数据库 =====
NOVEL_DB_PATH=data/novel_agent.db
