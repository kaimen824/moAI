# ===== LLM Provider =====
# 智谱 GLM API Key(https://open.bigmodel.cn/)
GLM_API_KEY=

# ===== 模型分级路由(按 Agent 角色,覆盖代码默认值)=====
# 强模型档:主控 / 大纲评审 / 审校 / 写作
MODEL__SUPERVISOR=glm-4.6
MODEL__OUTLINE=glm-4.6
MODEL__REVIEWER=glm-4.6
MODEL__WRITER=glm-4.6
# 中档:事件/事实抽取
MODEL__EVENT=glm-4.5-air
# 便宜档:角色管理 / 摘要
MODEL__CHARACTER=glm-4.5-flash
MODEL__SUMMARY=glm-4.5-flash
# embedding 独立配置
MODEL__EMBEDDING=embedding-3

# ===== 数据库 =====
NOVEL_DB_PATH=data/novel_agent.db
